{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VJ Studio",
  "version": "0.1.0",
  "identifier": "de.cuteghg.vjstudio",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VJ Studio",
        "width": 1600,
        "height": 960,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Multimedia",
    "shortDescription": "Live Video Mixer",
    "longDescription": "VJ Studio desktop mixer with video layers, effects, MIDI and Ableton Link network sync.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["German", "English"]
      }
    }
  }
}
